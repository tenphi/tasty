{
  "name": "@tenphi/tasty",
  "version": "3.7.0",
  "description": "A design-system-integrated styling system and DSL for concise, state-aware UI styling",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static/index.d.ts",
      "import": "./dist/static/index.js",
      "default": "./dist/static/index.js"
    },
    "./static/inject": {
      "types": "./dist/static/inject.d.ts",
      "import": "./dist/static/inject.js",
      "default": "./dist/static/inject.js"
    },
    "./babel-plugin": {
      "types": "./dist/zero/babel.d.ts",
      "import": "./dist/zero/babel.js",
      "default": "./dist/zero/babel.js"
    },
    "./zero": {
      "types": "./dist/zero/index.d.ts",
      "import": "./dist/zero/index.js",
      "default": "./dist/zero/index.js"
    },
    "./zero/next": {
      "types": "./dist/zero/next.d.ts",
      "import": "./dist/zero/next.js",
      "default": "./dist/zero/next.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js",
      "default": "./dist/ssr/index.js"
    },
    "./ssr/next": {
      "types": "./dist/ssr/next.d.ts",
      "import": "./dist/ssr/next.js",
      "default": "./dist/ssr/next.js"
    },
    "./ssr/next-config": {
      "types": "./dist/ssr/next-config.d.ts",
      "import": "./dist/ssr/next-config.js",
      "default": "./dist/ssr/next-config.js"
    },
    "./ssr/astro": {
      "types": "./dist/ssr/astro.d.ts",
      "import": "./dist/ssr/astro.js",
      "default": "./dist/ssr/astro.js"
    },
    "./ssr/astro-client": {
      "types": "./dist/ssr/astro-client.d.ts",
      "import": "./dist/ssr/astro-client.js",
      "default": "./dist/ssr/astro-client.js"
    },
    "./ssr/astro-middleware": {
      "types": "./dist/ssr/astro-middleware.d.ts",
      "import": "./dist/ssr/astro-middleware.js",
      "default": "./dist/ssr/astro-middleware.js"
    },
    "./ssr/astro-middleware-static": {
      "types": "./dist/ssr/astro-middleware-static.d.ts",
      "import": "./dist/ssr/astro-middleware-static.js",
      "default": "./dist/ssr/astro-middleware-static.js"
    },
    "./ssr/astro-middleware-extract": {
      "types": "./dist/ssr/astro-middleware-extract.d.ts",
      "import": "./dist/ssr/astro-middleware-extract.js",
      "default": "./dist/ssr/astro-middleware-extract.js"
    },
    "./ssr/astro-middleware-extract-static": {
      "types": "./dist/ssr/astro-middleware-extract-static.d.ts",
      "import": "./dist/ssr/astro-middleware-extract-static.js",
      "default": "./dist/ssr/astro-middleware-extract-static.js"
    },
    "./precompile": {
      "types": "./dist/precompile/index.d.ts",
      "import": "./dist/precompile/index.js",
      "default": "./dist/precompile/index.js"
    },
    "./precompile/register": {
      "types": "./dist/precompile/register.d.ts",
      "import": "./dist/precompile/register.js",
      "default": "./dist/precompile/register.js"
    },
    "./tasty.config": "./tasty.config.ts"
  },
  "files": [
    "dist",
    "docs",
    "tasty.config.ts"
  ],
  "sideEffects": [
    "./dist/ssr/index.js",
    "./dist/ssr/next.js",
    "./dist/ssr/astro.js",
    "./dist/ssr/astro-client.js",
    "./dist/ssr/astro-middleware.js",
    "./dist/ssr/astro-middleware-static.js",
    "./dist/ssr/astro-middleware-extract.js",
    "./dist/ssr/astro-middleware-extract-static.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:setup": "playwright install chromium",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "size": "size-limit",
    "bench": "vitest bench --project node",
    "bench:browser": "vitest bench --project browser",
    "bench:overhead": "vitest bench --config vitest.production-browser-bench.config.ts src/tasty-overhead.bench.tsx",
    "bench:injection": "vitest bench --config vitest.production-browser-bench.config.ts src/tasty-injection.bench.ts",
    "bench:interaction": "vitest bench --config vitest.production-browser-bench.config.ts src/tasty-interaction.bench.tsx",
    "bench:cold-start": "node scripts/cold-start/index.mjs",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "knip": "knip",
    "check:test-only": "node scripts/check-test-only-code.mjs",
    "hygiene": "pnpm lint && pnpm format:check && pnpm typecheck",
    "hygiene:fix": "pnpm lint:fix && pnpm format && pnpm typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/tasty.git"
  },
  "keywords": [
    "css-in-js",
    "styling",
    "design-system",
    "react",
    "state-aware",
    "zero-runtime",
    "babel-plugin",
    "typescript",
    "dsl"
  ],
  "author": "Andrey Yamanov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tenphi/tasty/issues"
  },
  "homepage": "https://github.com/tenphi/tasty#readme",
  "peerDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/helper-plugin-utils": "^7.24.0",
    "@babel/types": "^7.24.0",
    "jiti": "^2.6.1",
    "next": ">=14.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@babel/helper-plugin-utils": {
      "optional": true
    },
    "@babel/types": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "jiti": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "csstype": "^3.1.0"
  },
  "devDependencies": {
    "@astrojs/react": "^4.4.2",
    "@babel/core": "^7.24.0",
    "@babel/helper-plugin-utils": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@size-limit/esbuild": "^12.0.0",
    "@size-limit/file": "^12.0.0",
    "@tenphi/eslint-plugin-tasty": "^1.0.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__helper-plugin-utils": "^7.10.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "astro": "^5.18.2",
    "esbuild": "^0.27.7",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "knip": "^5.61.3",
    "next": "^16.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^12.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.24.0",
  "size-limit": [
    {
      "name": "main (import *)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "59 kB"
    },
    {
      "name": "core (import *)",
      "path": "dist/core/index.js",
      "import": "*",
      "limit": "56 kB"
    },
    {
      "name": "static",
      "path": "dist/static/index.js",
      "import": "*",
      "limit": "16.8 kB"
    },
    {
      "name": "zero",
      "path": "dist/zero/index.js",
      "import": "*",
      "ignore": [
        "fs",
        "path",
        "crypto"
      ],
      "limit": "31.25 kB"
    },
    {
      "name": "babel-plugin",
      "path": "dist/zero/babel.js",
      "import": "*",
      "ignore": [
        "fs",
        "path",
        "crypto"
      ],
      "limit": "50.2 kB"
    }
  ]
}
